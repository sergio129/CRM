# Configuración de la base de datos para desarrollo local
DB_HOST=localhost
DB_USER=gescoop_user
DB_PASSWORD=gescoop_password
DB_NAME=gescoop_db
DB_PORT=3306

# Configuración de JWT
JWT_SECRET=your_development_jwt_secret_key

# Configuración de correo electrónico para desarrollo
EMAIL_USER=desarrollo-email@example.com
EMAIL_PASS=desarrollo-email-password

# Claves de API externas para desarrollo
CREDIT_BUREAU_API_KEY=desarrollo-credit-bureau-api-key
INCOME_API_KEY=desarrollo-income-api-key

# Configuración de CORS
FRONTEND_URL=http://localhost:3000

# Configuración para depuración
DEBUG=true

FROM node:14 AS builder

# Instalar dependencias del sistema necesarias para compilar módulos nativos
RUN apt-get update && apt-get install -y \
    build-essential \
    python \
    make \
    gcc \
    g++ \
    && npm install -g node-gyp

# Crear directorio para la compilación
WORKDIR /build

# Copiar archivos de configuración
COPY package*.json ./

# Limpiar caché de npm y reconstruir desde cero
RUN npm cache clean --force && \
    npm install

# Reconstruir bcrypt específicamente para este entorno
RUN npm rebuild bcrypt --build-from-source

# Segunda etapa - imagen final
FROM node:14-slim

WORKDIR /usr/src/app

# Instalar solo las dependencias de producción
COPY package*.json ./
RUN npm install --only=production

# Copiar node_modules ya compilados desde la etapa de construcción
COPY --from=builder /build/node_modules/bcrypt ./node_modules/bcrypt

# Copiar el código fuente
COPY . .

# Crear directorio de logs
RUN mkdir -p /usr/src/app/logs

# Establecer permisos
RUN chmod -R 755 /usr/src/app

# Puerto de la aplicación
EXPOSE 5000

# Configuración de producción
ENV NODE_ENV=production

# Comando para iniciar la aplicación
CMD ["node", "app.js"]
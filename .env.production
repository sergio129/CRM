# Configuración de la base de datos para producción en Docker
DB_HOST=db
DB_USER=gescoop_user
DB_PASSWORD=gescoop_password
DB_NAME=gescoop_db
DB_PORT=3306

# Configuración de JWT
JWT_SECRET=your_production_jwt_secret_key

# Configuración de correo electrónico para producción
EMAIL_USER=produccion-email@example.com
EMAIL_PASS=produccion-email-password

# Claves de API externas
CREDIT_BUREAU_API_KEY=produccion-credit-bureau-api-key
INCOME_API_KEY=produccion-income-api-key

# Configuración de CORS
FRONTEND_URL=http://localhost:5000
